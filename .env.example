# Console login / 控制台登录
CONSOLE_PASSWORD=your-console-password

# Page title and description / 页面标题与描述
SITE_TITLE=短链管理控制台
SITE_DESCRIPTION=创建、查询和管理随机跳转短链

# API target configuration (JSON array) / API 目标配置（JSON 数组）
# apiBaseUrl must use HTTPS / apiBaseUrl 必须使用 HTTPS
# Fields / 字段：id、name、apiBaseUrl、adminToken、redirectBaseUrl
API_TARGETS=[{"id":"prod","name":"生产环境","apiBaseUrl":"https://api.link.microbin.dev","adminToken":"your-prod-admin-token","redirectBaseUrl":"https://link.microbin.dev"},{"id":"staging","name":"预发布环境","apiBaseUrl":"https://api-staging.link.microbin.dev","adminToken":"your-staging-admin-token","redirectBaseUrl":"https://link-staging.microbin.dev"}]

# Default target ID (optional; first valid target by default) / 默认环境 ID（可选）
DEFAULT_TARGET_ID=prod
